# Proxy
PROXY_PORT=3000
PROXY_BASE_URL=https://your-proxy.example.com

# Slack App (Static Registration)
SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret
SLACK_MCP_URL=https://mcp.slack.com/mcp

# Slack OAuth scopes for user tokens (comma-separated)
SLACK_USER_SCOPES=search:read.public,search:read.private,search:read.im,search:read.files,search:read.users,chat:write

# Storage
DB_PATH=./data/proxy.db

# Session TTL in seconds (default: 600 = 10 minutes)
SESSION_TTL_SECONDS=600

# Token encryption key — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-64-hex-char-key-here

# Slack OAuth endpoints (injectable for testing — defaults to real Slack)
# SLACK_AUTHORIZE_URL=https://slack.com/oauth/v2/authorize
# SLACK_TOKEN_URL=https://slack.com/api/oauth.v2.access
